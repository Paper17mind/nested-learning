# ==============================================================================
# Konfigurasi LLM Teacher untuk Nested Learning Lite (HOPE)
# ==============================================================================

# Pilihan Provider API:
# 1. OpenRouter / 9router:
#    OPENAI_BASE_URL=https://openrouter.ai/api/v1
#    OPENAI_API_KEY=sk-or-v1-xxxxxxxxxxxxxxxxxxxxxxxx
#    LLM_MODEL=meta-llama/llama-3-8b-instruct:free (atau model pilihan Anda)
#
# 2. OpenAI Resmi:
#    OPENAI_BASE_URL=https://api.openai.com/v1
#    OPENAI_API_KEY=sk-proj-xxxxxxxxxxxxxxxxxxxxxxxx
#    LLM_MODEL=gpt-4o-mini
#
# 3. Groq (Gratis & Sangat Cepat):
#    OPENAI_BASE_URL=https://api.groq.com/openai/v1
#    OPENAI_API_KEY=gsk_xxxxxxxxxxxxxxxxxxxxxxxx
#    LLM_MODEL=llama-3.1-8b-instant
#
# 4. Ollama Lokal:
#    OLLAMA_HOST=http://localhost:11434
#    LLM_MODEL=llama3

# ==============================================================================
LLM_MODEL=meta-llama/llama-3-8b-instruct:free
LLM_TEACHER=auto
OPENAI_BASE_URL=https://openrouter.ai/api/v1
OPENAI_API_KEY=your_api_key_here
LLM_MODEL=meta-llama/llama-3-8b-instruct:free
LLM_TEACHER=openai
